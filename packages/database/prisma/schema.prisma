generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum AreaStatus {
  ACTIVE
  DISABLED
}

enum TenantStatus {
  ACTIVE
  DISABLED
}

enum SubjectSource {
  WIKIPEDIA
  FALLBACK
  MANUAL
}

enum SubjectStatus {
  ACTIVE
  UNDER_REVIEW
  HIDDEN
}

enum CandidateStatus {
  CANDIDATE
  SELECTED
  REJECTED
  USED
}

enum DailySubjectStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  REPLACED
}

enum UserDailyItemStatus {
  PENDING
  VIEWED
  LEARNED
  SKIPPED
  MISSED
  REPLACED
}

model AppSettings {
  id                   Int      @id @default(1)
  defaultReadingMinutes Int     @default(5)
  updatedAt            DateTime @updatedAt
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  language  String
  domain    String?
  isDefault Boolean  @default(false)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  areas                 Area[]
  subjects              Subject[]
  candidates            AreaSubjectCandidate[]
  dailySubjects         DailyAreaSubject[]
  userAreas             UserArea[]
  userDailyItems        UserDailyItem[]
  inaccuracyReports     InaccuracyReport[]
  auditLogs             AuditLog[]
  analyticsEvents       AnalyticsEvent[]
}

enum ReportReason {
  INACCURATE
  OUTDATED
  OFFENSIVE
  MISLEADING_SUMMARY
  BROKEN_SOURCE
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  NEW
  REVIEWING
  RESOLVED
  DISMISSED
}

model User {
  id            String        @id @default(cuid())
  tenantId      String
  name          String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  role          Role          @default(USER)
  status        UserStatus    @default(ACTIVE)
  timezone      String        @default("UTC")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts        Account[]
  sessions        Session[]
  userAreas       UserArea[]
  dailyItems      UserDailyItem[]
  reports         InaccuracyReport[]
  auditLogs       AuditLog[]
  analyticsEvents AnalyticsEvent[]

  @@unique([id, tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Area {
  id           String     @id @default(cuid())
  tenantId     String
  name         String
  slug         String
  description  String?
  iconUrl      String?
  color        String?
  status       AreaStatus @default(ACTIVE)
  displayOrder Int        @default(0)
  sourceConfig Json
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userAreas      UserArea[]
  candidates     AreaSubjectCandidate[]
  dailySubjects  DailyAreaSubject[]
  userDailyItems UserDailyItem[]

  @@unique([slug, tenantId])
  @@unique([name, tenantId])
  @@unique([id, tenantId])
}

model Subject {
  id               String        @id @default(cuid())
  tenantId         String
  source           SubjectSource @default(WIKIPEDIA)
  sourcePageId     String?
  title            String
  canonicalUrl     String
  summary          String
  hook             String?
  imageUrl         String?
  imageLicense     String?
  imageAttribution String?
  contentHash      String
  language         String        @default("en")
  revisionId       String?
  retrievedAt      DateTime      @default(now())
  license          String?
  qualityScore     Float         @default(0)
  safetyScore      Float         @default(100)
  status           SubjectStatus @default(ACTIVE)
  raw              Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidates     AreaSubjectCandidate[]
  dailySubjects  DailyAreaSubject[]
  userDailyItems UserDailyItem[]
  reports        InaccuracyReport[]

  @@unique([canonicalUrl, tenantId])
  @@unique([contentHash, tenantId])
  @@unique([id, tenantId])
  @@index([source, sourcePageId])
  @@index([status])
}

model AreaSubjectCandidate {
  id               String          @id @default(cuid())
  tenantId         String
  areaId           String
  subjectId        String
  generatedForDate DateTime        @db.Date
  candidateScore   Float           @default(0)
  status           CandidateStatus @default(CANDIDATE)
  createdAt        DateTime        @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  area    Area    @relation(fields: [areaId, tenantId], references: [id, tenantId], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([areaId, subjectId, generatedForDate, tenantId])
  @@index([tenantId, areaId, generatedForDate, status])
}

model DailyAreaSubject {
  id          String             @id @default(cuid())
  tenantId    String
  contentDate DateTime           @db.Date
  areaId      String
  subjectId   String
  status      DailySubjectStatus @default(PUBLISHED)
  selectedBy  String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  area           Area            @relation(fields: [areaId, tenantId], references: [id, tenantId], onDelete: Cascade)
  subject        Subject         @relation(fields: [subjectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  userDailyItems UserDailyItem[]

  @@unique([contentDate, areaId, tenantId])
  @@unique([id, tenantId])
  @@index([tenantId, contentDate, status])
}

model UserArea {
  tenantId         String
  userId           String
  areaId           String
  preferenceWeight Float    @default(1)
  assignedBy       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  area Area @relation(fields: [areaId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([userId, areaId])
}

model UserDailyItem {
  id                 String              @id @default(cuid())
  tenantId           String
  userId             String
  contentDate        DateTime            @db.Date
  userLocalDate      DateTime            @db.Date
  areaId             String
  subjectId          String
  dailyAreaSubjectId String?
  status             UserDailyItemStatus @default(PENDING)
  assignedAt         DateTime            @default(now())
  viewedAt           DateTime?
  learnedAt          DateTime?
  rating             Int?
  ratingComment      String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  area             Area               @relation(fields: [areaId, tenantId], references: [id, tenantId], onDelete: Cascade)
  subject          Subject            @relation(fields: [subjectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  dailyAreaSubject DailyAreaSubject?  @relation(fields: [dailyAreaSubjectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  reports          InaccuracyReport[]

  @@unique([userId, contentDate])
  @@unique([id, tenantId])
  @@index([tenantId, userId, status, contentDate])
}

model InaccuracyReport {
  id              String       @id @default(cuid())
  tenantId        String
  userId          String?
  userDailyItemId String?
  subjectId       String
  reason          ReportReason
  details         String?
  status          ReportStatus @default(NEW)
  createdAt       DateTime     @default(now())
  reviewedBy      String?
  reviewedAt      DateTime?
  resolutionNote  String?

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?           @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  userDailyItem UserDailyItem?  @relation(fields: [userDailyItemId, tenantId], references: [id, tenantId], onDelete: Cascade)
  subject       Subject         @relation(fields: [subjectId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  name      String
  payload   Json?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
}
