{
  "name": "narau",
  "private": true,
  "packageManager": "bun@1.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "bun run test:structure && turbo run test",
    "test:structure": "node --test tests/project-structure.test.mjs",
    "format": "prettier --write .",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "db:migrate": "bun --filter @narau/database db:migrate",
    "db:push": "bun --filter @narau/database db:push",
    "db:generate": "bun --filter @narau/database db:generate",
    "db:seed": "bun --filter @narau/database db:seed",
    "db:studio": "bun --filter @narau/database db:studio",
    "worker:dev": "bun --filter @narau/worker dev",
    "worker:build": "bun --filter @narau/worker build",
    "job:ingest": "bun --filter @narau/worker job:ingest",
    "job:select": "bun --filter @narau/worker job:select",
    "job:assign": "bun --filter @narau/worker job:assign",
    "job:remind": "bun --filter @narau/worker job:remind",
    "postinstall": "bun --filter @narau/database db:generate"
  },
  "devDependencies": {
    "@narau/config": "workspace:*",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript-eslint": "^8.26.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "version": "1.1.0"
}
