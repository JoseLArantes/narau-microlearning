# App
NODE_ENV=development
APP_URL=http://localhost:3030

# Database
DATABASE_URL=postgresql://app:app@localhost:5434/narau?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth.js
AUTH_SECRET=change-me
AUTH_URL=http://localhost:3030
AUTH_TRUST_HOST=true

# LLM settings encryption (use a unique random secret in production)
LLM_SETTINGS_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# OAuth Social Logins (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Email / SMTP
EMAIL_FROM="Narau <no-reply@localhost>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Storage / S3-compatible
STORAGE_ENABLED=false
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=narau
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/narau

# Wikipedia
WIKIPEDIA_USER_AGENT="NarauBot/0.1 (local dev; contact@example.com)"
WIKIPEDIA_REQUEST_DELAY_MS=10000
